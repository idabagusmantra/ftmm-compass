{
  "name": "ftmm-compass-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:backend": "uv run --directory backend python app.py",
    "dev:all": "concurrently -n backend,frontend -c magenta,cyan \"pnpm dev:backend\" \"pnpm dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "get-image-colors": "^4.0.1",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
